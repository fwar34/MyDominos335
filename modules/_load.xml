<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
<!-- 模块加载清单：按顺序加载各功能模块脚本；castBar 与 totemBar 通过 Include 引入各自 xml，
     xml 内再规定脚本加载顺序。 -->
<!-- Default modules -->
<Script file="actionBar.lua" />
<Script file="petBar.lua" />
<Script file="classBar.lua" />
<Script file="bagBar.lua" />
<Script file="menuBar.lua" />
<Script file="vehicleBar.lua" />

<!-- Integrated external modules -->
<Include file="castBar\castBar.xml" />
<Include file="totemBar\totemBar.xml" />
<Script file="rollBar.lua" />
<Script file="xpBar.lua" />

<!-- Additional custom modules -->
<Script file="auraBuffsBar.lua" />
<Script file="auraDebuffsBar.lua" />
<Script file="minimapBar.lua" />
<Script file="minimapZoneTextBar.lua" />
<Script file="questTracker.lua" />
</Ui>